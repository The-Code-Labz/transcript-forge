# Server
PORT=4050
NODE_ENV=production
TRANSCRIPT_FORGE_API_KEY=change-me-in-production
CORS_ORIGIN=*

# Transcription provider: voidai | deepgram
TRANSCRIBE_PROVIDER=voidai

# VoidAI / OpenAI-compatible transcription (used when TRANSCRIBE_PROVIDER=voidai)
VOIDAI_BASE_URL=https://api.voidai.app/v1
VOIDAI_API_KEY=your-voidai-key
TRANSCRIBE_MODEL=gpt-4o-transcribe

# Deepgram (used when TRANSCRIBE_PROVIDER=deepgram)
DEEPGRAM_API_KEY=your-deepgram-key
DEEPGRAM_MODEL=nova-2

# Job queue
REDIS_URL=redis://redis:6379

# Storage: local | minio | s3
STORAGE_BACKEND=local
LOCAL_DATA_DIR=./data

# MinIO / S3 (only needed if STORAGE_BACKEND=minio or s3)
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=transcript-forge
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=

# Processing
CHUNK_MINUTES=10
MAX_FILE_SIZE_BYTES=5368709120

# Traefik (only needed if using docker-compose.traefik.yml)
DOMAIN=transcript-forge.example.com
CERT_RESOLVER=letsencrypt
